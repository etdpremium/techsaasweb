{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techsaasweb",
  "account_id": "fd37cbb5c77d0f679a1d63f7fc71062a",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.open-next/worker.js",
  "assets": {
    "directory": "./.open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techsaasweb-db",
      "database_id": "f7fd20e7-34ca-416c-a69e-9a14a5f2e6de"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://techsaasweb.com"
  }
}
