# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Login Google (opsional — isi setelah buat OAuth Client di Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kunci redirect_uri di production (WAJIB sama persis dengan yang terdaftar di console).
# Contoh: GOOGLE_REDIRECT_URI=https://techsaasweb.com/api/auth/google
#GOOGLE_REDIRECT_URI=
# Cloudflare Workers AI (opsional, 10rb neurons/hari gratis — prioritas utama bila diisi)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_MODEL= (opsional, default @cf/meta/llama-3.3-70b-instruct-fp8-fast)
